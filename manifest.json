{
  "manifest_version": 3,
  "name": "Jira Quick Search",
  "version": "1.0.0",
  "description": "Recherche rapide de tickets Jira Cloud et récapitulatif d’activité",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.atlassian.net/*"
  ],
  "action": {
    "default_title": "Jira Quick Search"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/jira-quick-search.png",
    "32": "icons/jira-quick-search.png",
    "64": "icons/jira-quick-search.png",
    "128": "icons/jira-quick-search.png"
  }
}
